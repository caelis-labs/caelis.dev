---
import ProjectPage from '../../components/ProjectPage.astro';
import BotProjectPage from '../../components/BotProjectPage.astro';
import { projects } from '../../data/site';
export function getStaticPaths() { return projects.map(project => ({ params: { project: project.id }, props: { project } })); }
const { project } = Astro.props;
---
{project.id === 'caelis-bot' ? <BotProjectPage project={project} lang="en"/> : <ProjectPage project={project} lang="en"/>}
