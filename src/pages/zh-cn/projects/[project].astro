---
import ProjectPage from '../../../components/ProjectPage.astro';
import { projects } from '../../../data/site';
export function getStaticPaths() { return projects.filter(project => project.id !== 'caelis-bot').map(project => ({ params: { project: project.id }, props: { project } })); }
const { project } = Astro.props;
---
<ProjectPage project={project} lang="zh-cn"/>
