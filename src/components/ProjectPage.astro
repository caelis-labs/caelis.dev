---
import SiteLayout from '../layouts/SiteLayout.astro';
import Icon from './Icon.astro';
import Demo from './Demo.astro';
import Install from './Install.astro';
import { localePath, statusLabel, repository, ui, type Locale, type Project } from '../data/site';
const { lang = 'en', project } = Astro.props as { lang?: Locale; project: Project };
const t = ui[lang]; const content = project[lang]; const repo = repository(project);
const releases = `${repo}/releases${project.status === 'release' ? '/latest' : ''}`;
const start = localePath(lang, `/docs/${project.id}/${project.id === 'caelis' ? 'installation/' : 'quickstart/'}`);
const cta = project.id === 'caelis-app' ? (lang === 'en' ? 'Historical guide' : '历史指南') : t.installation;
---
<SiteLayout lang={lang} title={project.name} description={content.description}>
  <section class="page-hero" id="top"><div class="container">
    <div class="breadcrumbs"><a href={localePath(lang, '/projects/')}>{t.projects}</a><span>/</span><span>{project.name}</span></div>
    <div class="project-hero-top"><p class="eyebrow">{content.label}</p><span class="status-label">{statusLabel(project,lang)}</span></div>
    <h1>{project.name}<span class="heading-period">.</span></h1>
    <p class="lead">{content.description}</p>
    <div class="actions"><a class="button primary" href={start}>{cta}<Icon name="arrow" size={18}/></a>{project.id !== 'caelis-app' && <a class="button secondary" href={repo}><Icon name="github" size={17}/>{t.source}</a>}</div>
    <div class="project-meta"><span>{project.platform}</span>{project.status === 'beta' ? <span>{lang === 'en' ? 'Historical beta' : '历史 Beta'}</span> : <a href={releases}>{project.status === 'release' ? t.latestRelease : t.release}<Icon name="external" size={14}/></a>}</div>
  </div></section>
  <section class="section"><div class="container">
    {project.id === 'caelis' && <Demo lang={lang}/>}
    {project.id === 'acp-go-sdk' && <div class="product-start"><div><p class="eyebrow">AGENT CLIENT PROTOCOL</p><h2 class="project-subtitle">{content.tagline.split('\n').map(line => <span>{line}<br/></span>)}</h2></div><div class="code-example"><div class="code-label"><span>GO MODULE</span></div><pre><code><span class="code-comment">{lang === 'en' ? '// Start with an open protocol.' : '// 从开放协议开始。'}</span>{'\n\ngo get github.com/caelis-labs/acp-go-sdk@latest\n\n'}<span class="code-comment">{lang === 'en' ? '// Build your agent. Connect your client.' : '// 构建 Agent，连接 Client。'}</span></code></pre></div></div>}
    {project.id === 'memory' && <div class="product-start"><div><p class="eyebrow">AN EMBEDDED MEMORY SYSTEM</p><h2 class="project-subtitle">{content.tagline.split('\n').map(line => <span>{line}<br/></span>)}</h2></div><div class="code-example"><div class="code-label"><span>{lang === 'en' ? 'MODEL-FACING INTERFACE' : '面向模型的接口'}</span></div><pre><code><span class="code-comment">{lang === 'en' ? '// A small interface. A durable foundation.' : '// 简洁的接口，持久的基础。'}</span>{'\n\nremember(text)\nrecall(query)\n\n'}<span class="code-comment">{lang === 'en' ? '// Your host owns identity and authority.' : '// 宿主负责身份与授权。'}</span></code></pre></div></div>}
    {project.id === 'caelis-app' && <div class="product-start"><div><p class="eyebrow">DESKTOP / ACP</p><h2 class="project-subtitle">{content.tagline.split('\n').map(line => <span>{line}<br/></span>)}</h2></div><div class="product-notice"><p>{lang === 'en' ? 'This is a saved early-beta project. Its previously public repository is currently unavailable; the guides are kept as historical reference. See Caelis Bot for the current desktop companion.' : '这里保留早期 Beta 项目资料。原公开仓库目前无法访问，指南仅作为历史参考。当前桌面伙伴请查看 Caelis Bot。'}</p><a class="text-link" href={start}>{lang === 'en' ? 'Read the saved guide' : '阅读历史指南'}<Icon name="arrow" size={18}/></a></div></div>}
    <div class="product-feature-list">{content.features.map(([title,description],i) => <article><span>{String(i+1).padStart(2,'0')}</span><h3>{title}</h3><p>{description}</p></article>)}</div>
  </div></section>
  <section class="section bot-section" id="cli"><div class="container product-start"><div><p class="eyebrow">{t.installation}</p><h2 class="project-subtitle">{lang === 'en' ? 'Make the first connection.' : '建立第一次连接。'}</h2><p>{project.id === 'caelis' ? (lang === 'en' ? 'Install Caelis, open a workspace, and connect your first model or agent.' : '安装 Caelis，打开工作区，连接第一个模型或智能体。') : content.short}</p><a class="text-link" href={localePath(lang, `/docs/${project.id}/`)}>{t.productDocs}<Icon name="arrow" size={18}/></a></div>
    {project.id === 'caelis' ? <Install lang={lang}/> : <div class="product-notice">
      {project.id === 'acp-go-sdk' && <p>{lang === 'en' ? 'Start with the minimal agent and client examples. No model account is needed for the fixed-response example.' : '从最小 Agent 和 Client 示例开始。运行固定回复的入门示例，无需模型账号。'}</p>}
      {project.id === 'memory' && <p>{lang === 'en' ? 'Integrate the published Go module in your host. Memory is embedded; it does not need a separate server or installation when used inside Caelis.' : '将已发布的 Go 模块集成进宿主。Memory 以嵌入式方式运行，在 Caelis 中使用时无需独立服务或额外安装。'}</p>}
      {project.id === 'caelis-app' && <p>{lang === 'en' ? 'The saved development guide describes an earlier source revision. A current installer or accessible source has not been verified.' : '历史开发指南描述早期源码版本，尚未核实当前可用的安装包或公开源码。'}</p>}
      <div class="actions"><a class="button primary" href={start}>{cta}<Icon name="arrow" size={18}/></a>{project.status !== 'beta' && <a class="text-link" href={releases}>{project.status === 'release' ? t.latestRelease : t.release}<Icon name="external" size={16}/></a>}</div>
    </div>}
  </div></section>
</SiteLayout>
