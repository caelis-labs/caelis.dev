---
import Default from '@astrojs/starlight/components/PageTitle.astro';
import ProjectLinks from './ProjectLinks.astro';
import { getLocale, localePath, projects } from '../../data/site';
const { entry } = Astro.locals.starlightRoute; const lang = getLocale(Astro.url.pathname);
const project = projects.find(p => p.id === entry.data.project);
---
<div class="doc-breadcrumb"><a href={localePath(lang, '/docs/')}>{lang === 'en' ? 'Documentation' : '文档'}</a>{project && <><span>/</span><a href={localePath(lang, `/docs/${project.id}/`)}>{project.name}</a></>}</div>
<Default/>
{entry.data.description && <p class="doc-description">{entry.data.description}</p>}
{entry.data.productVersion && <div class="doc-version">{project?.name} <span>{entry.data.productVersion}</span></div>}
{['/docs/', '/zh-cn/docs/'].includes(Astro.url.pathname) && <ProjectLinks lang={lang}/>}
