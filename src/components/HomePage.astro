---
import SiteLayout from '../layouts/SiteLayout.astro';
import Brand from './Brand.astro';
import Icon from './Icon.astro';
import BotLogo from './BotLogo.astro';
import BotDownload from './BotDownload.astro';
import Demo from './Demo.astro';
import Install from './Install.astro';
import ProjectRows from './ProjectRows.astro';
import { localePath, projects, ui, type Locale } from '../data/site';
const { lang = 'en' } = Astro.props as { lang?: Locale }; const t = ui[lang]; const bot = projects[1][lang];
---
<SiteLayout lang={lang} description={t.intro}>
  <section class="hero" id="top" aria-labelledby="hero-title">
    <canvas id="hero-canvas" class="hero-canvas" aria-hidden="true"></canvas>
    <div class="hero-halo" aria-hidden="true"></div>
    <div class="hero-content container">
      <div class="hero-brand"><Brand lang={lang} large/></div>
      <h1 id="hero-title">{t.heroLine1}<br/><span>{t.heroLine2}</span></h1>
      <p class="hero-description">{t.intro}</p>
      <div class="actions"><a class="button primary" href="#projects">{t.explore}<Icon name="arrow" size={18}/></a><a class="button secondary" href={localePath(lang, '/docs/')}><Icon name="book" size={18}/>{t.readDocs}</a></div>
    </div>
    <div class="hero-bottom container"><span>{t.eyebrow}</span><a href="#projects" aria-label={t.explore}>↓</a><span>EST. 2026</span></div>
  </section>

  <section class="section featured-section" id="projects" aria-labelledby="caelis-heading">
    <div class="container">
      <div class="section-heading reveal"><div><p class="eyebrow">{t.featured}</p><h2 id="caelis-heading">Caelis<span class="heading-period">.</span></h2></div><div class="section-heading-copy"><p>{projects[0][lang].description}</p><a class="text-link" href={localePath(lang, '/projects/caelis/')}>{t.learn}<Icon name="arrow" size={18}/></a></div></div>
      <div class="reveal demo-focus"><Demo lang={lang}/></div>
      <div class="feature-bottom" id="cli"><div><h3>{lang === 'en' ? 'Your next team starts here.' : '下一次协作，从这里开始。'}</h3><p>{lang === 'en' ? 'Open a terminal. Bring your own intelligence.' : '打开终端，连接你选择的智能。'}</p></div><Install lang={lang}/></div>
    </div>
  </section>

  <section class="section bot-section" aria-labelledby="bot-heading">
    <div class="container bot-layout">
      <div class="bot-copy reveal"><p class="eyebrow">{t.botFeature}</p><h2 id="bot-heading">Caelis Bot<span class="heading-period">.</span></h2><h3>{bot.tagline.split('\n').map(line => <span>{line}</span>)}</h3><p>{bot.description}</p><div class="actions"><BotDownload lang={lang}/><a class="text-link" href={localePath(lang, '/projects/caelis-bot/')}>{bot.cta}<Icon name="arrow" size={18}/></a></div><span class="footnote">{t.botNote}</span></div>
      <div class="bot-portrait reveal"><div class="bot-orbit" aria-hidden="true"></div><BotLogo lazy/><span class="bot-presence"><i></i>{lang === 'en' ? 'Here, when you need a hand.' : '需要时，就在你身边。'}</span><div class="bot-portrait-caption"><span>CAELIS BOT</span><span>YOUR DESKTOP COMPANION ↗</span></div></div>
    </div>
  </section>

  <section class="section building-section" aria-labelledby="building-heading"><div class="container"><div class="section-intro reveal"><p class="eyebrow">{lang === 'en' ? '03—05 / KEEP BUILDING' : '03—05 / 继续构建'}</p><h2 id="building-heading">{t.building}</h2><p>{t.buildingSub}</p></div><ProjectRows lang={lang} items={projects.slice(2)} start={2}/><a class="text-link all-projects-link" href={localePath(lang, '/projects/')}>{t.all}<Icon name="arrow" size={18}/></a></div></section>

  <section class="docs-invitation"><div class="container docs-invitation-inner reveal"><div><p class="eyebrow">{t.docs}</p><h2>{t.docsTitle}</h2><p>{t.docsText}</p></div><a class="button primary" href={localePath(lang, '/docs/')}>{t.docsCta}<Icon name="arrow" size={18}/></a></div></section>
  <script>import '../scripts/sky';</script>
</SiteLayout>
